{
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "outputDirectory": "release/public",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/game.js": {
      "includeFiles": "release/cloud.cjs",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/game?route=health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/game?route=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "35 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'"
        }
      ]
    }
  ]
}
