{
  "name": "async-card-game",
  "version": "1.0.0",
  "description": "Asynchronous Card Game Platform - Turn-based card games played over days",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && npm start",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client",
    "build": "node scripts/build.mjs",
    "build:server": "npm run build --workspace=packages/server",
    "build:client": "npm run build --workspace=packages/client",
    "start": "node release/server.cjs",
    "test": "npm run build && node --test scripts/release.test.mjs",
    "lint": "npm run lint --workspaces",
    "db:migrate": "npm run db:migrate --workspace=packages/server",
    "db:seed": "npm run db:seed --workspace=packages/server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "pg": "^8.23.1",
    "web-push": "^4.0.0"
  }
}
